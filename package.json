{
  "name": "mrmallorcagolf",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/convert-og-images.mjs",
    "build": "next build",
    "start": "next start",
    "prepare": "node scripts/setup-git-hooks.js",
    "lint": "next lint",
    "check:text": "node scripts/check-text-corruption.js",
    "check:social-proof": "node --no-warnings scripts/sync-social-proof.mjs --check",
    "check:offers": "node --no-warnings scripts/check-offers-consistency.js",
    "check:content": "npm run check:text && npm run check:social-proof && npm run check:offers && npm run check:locale && npm run check:shared-locale && npm run check:routes && npm run check:course-data && npm run check:pointers && npm run check:links && npm run check:voice && npm run check:tool-prices && npm run check:tool-green-fees && npm run check:pricing-narrative && npm run check:guide-parity && node --no-warnings scripts/check-guide-review-keywords.js",
    "check:locale": "node --no-warnings scripts/check-locale-content.js",
    "check:locale-leaks": "node --no-warnings scripts/check-locale-english-leaks.js",
    "check:shared-locale": "node --no-warnings scripts/check-shared-locale-fallbacks.js && node --no-warnings scripts/check-localized-overlay-integrity.js",
    "check:guide-locale-leaks": "node --no-warnings scripts/check-guide-locale-english-leaks.js",
    "check:locale-parity": "node scripts/check-locale-parity.js",
    "check:routes": "node --no-warnings scripts/check-route-parity.mjs && node --no-warnings scripts/check-locale-route-files.mjs",
    "check:content-validation": "node scripts/validate-content.mjs",
    "check:pointers": "node scripts/check-doc-pointers.mjs",
    "check:links": "node --no-warnings scripts/check-internal-links.mjs",
    "check:voice": "node scripts/check-voice.mjs",
    "check:tool-prices": "node scripts/check-tool-price-sync.mjs",
    "check:tool-green-fees": "node --no-warnings scripts/check-tool-green-fees.mjs",
    "check:pricing-narrative": "node --no-warnings scripts/check-pricing-narrative.mjs",
    "check:guide-parity": "node --no-warnings scripts/check-guide-parity.mjs",
    "check:course-data": "node --no-warnings scripts/check-course-destinations.js && node --no-warnings scripts/check-scorecard-data.js && node --no-warnings scripts/check-course-access-data.js && node --no-warnings scripts/check-tracker-course-pack.js",
    "export:blog-content": "node --no-warnings scripts/export-live-guide-content.mjs",
    "sync:social-proof": "node --no-warnings scripts/sync-social-proof.mjs",
    "generate:lead-magnet-pdfs": "python scripts/generate-lead-magnet-pdfs.py",
    "check:i18n-release": "node --no-warnings scripts/locale-release-check.js",
    "check:lighthouse": "node scripts/lighthouse-scorecard.mjs",
    "check:visual": "playwright test",
    "check:responsive": "node scripts/responsive-audit.js",
    "check:responsive:live": "node scripts/responsive-audit.js --base-url https://www.mrmallorcagolf.com",
    "sync:strokes-gained-course-data": "npm run check:course-data && node --no-warnings scripts/export-strokes-gained-course-data.mjs && node --no-warnings scripts/check-strokes-gained-export.js",
    "check:ready": "npm run check:content && npm run check:i18n-release && npm run build",
    "predeploy": "npm run check:text && npm run check:i18n-release && npm run build",
    "ops:daily": "node scripts/site-ops/run-daily-health-check.mjs && node scripts/site-ops/generate-master-priority-report.mjs",
    "ops:weekly": "node scripts/site-ops/run-weekly-seo-performance.mjs && node scripts/site-ops/generate-master-priority-report.mjs",
    "ops:monthly": "node scripts/site-ops/run-monthly-technical-audit.mjs && node scripts/site-ops/generate-master-priority-report.mjs",
    "ops:master": "node scripts/site-ops/generate-master-priority-report.mjs",
    "ops:install-tasks": "powershell -ExecutionPolicy Bypass -File scripts/site-ops/install-windows-scheduled-tasks.ps1",
    "indexnow": "node scripts/indexnow-ping.mjs",
    "skills:sync": "node scripts/sync-agent-skills.mjs",
    "convert-og-images": "node scripts/convert-og-images.mjs"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.0",
    "next": "^15.5.18",
    "pptxgenjs": "^4.0.1",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "docx": "^9.7.1",
    "eslint": "^8",
    "eslint-config-next": "^15.5.18",
    "sharp": "^0.34.5"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
