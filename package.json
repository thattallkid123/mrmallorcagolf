{
  "name": "mrmallorcagolf",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare": "node scripts/setup-git-hooks.js",
    "lint": "next lint",
    "check:text": "node scripts/check-text-corruption.js",
    "check:offers": "node --no-warnings scripts/check-offers-consistency.js",
    "check:content": "npm run check:text && npm run check:offers && npm run check:locale && npm run check:shared-locale",
    "check:locale": "node scripts/check-locale-content.js",
    "check:locale-leaks": "node scripts/check-locale-english-leaks.js",
    "check:shared-locale": "node scripts/check-shared-locale-fallbacks.js",
    "check:guide-locale-leaks": "node scripts/check-guide-locale-english-leaks.js",
    "check:i18n-release": "node scripts/locale-release-check.js",
    "check:lighthouse": "node scripts/lighthouse-scorecard.mjs",
    "check:visual": "playwright test",
    "check:ready": "npm run check:content && npm run check:i18n-release && npm run build",
    "predeploy": "npm run check:text && npm run check:i18n-release && npm run build",
    "ops:daily": "node scripts/site-ops/run-daily-health-check.mjs && node scripts/site-ops/generate-master-priority-report.mjs",
    "ops:weekly": "node scripts/site-ops/run-weekly-seo-performance.mjs && node scripts/site-ops/generate-master-priority-report.mjs",
    "ops:monthly": "node scripts/site-ops/run-monthly-technical-audit.mjs && node scripts/site-ops/generate-master-priority-report.mjs",
    "ops:master": "node scripts/site-ops/generate-master-priority-report.mjs",
    "ops:install-tasks": "powershell -ExecutionPolicy Bypass -File scripts/site-ops/install-windows-scheduled-tasks.ps1"
  },
  "dependencies": {
    "next": "^15.5.18",
    "pptxgenjs": "^4.0.1",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "^15.5.18",
    "sharp": "^0.34.5"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
