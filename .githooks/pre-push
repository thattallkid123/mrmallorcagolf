#!/bin/sh
set -eu

echo "Running content guardrails before push..."
npm run check:content

if [ "${SKIP_MMG_CONTENT_EXPORT:-}" = "1" ]; then
  echo "Skipping MMG Blog Content export because SKIP_MMG_CONTENT_EXPORT=1."
  exit 0
fi

echo "Exporting live guide/article text to Google Drive before push..."
npm run export:blog-content
