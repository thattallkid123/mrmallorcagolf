{
  "framework": "nextjs",
  "crons": [
    { "path": "/api/cron/indexnow", "schedule": "0 6 * * *" }
  ],
  "redirects": [
    {
      "source": "/handicap-checker.html",
      "destination": "/tools/handicap-checker",
      "permanent": true
    },
    {
      "source": "/coaching",
      "destination": "/play-with-a-pro",
      "permanent": true
    },
    {
      "source": "/:locale(de|es|fr|nl|sv|zh)/coaching",
      "destination": "/:locale/play-with-a-pro",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/:locale(de|es|fr|nl|sv|zh)/blog",
      "destination": "/:locale/guides",
      "permanent": true
    },
    {
      "source": "/courses",
      "destination": "/golf-courses",
      "permanent": true
    },
    {
      "source": "/:locale(de|es|fr|nl|sv|zh)/courses",
      "destination": "/:locale/golf-courses",
      "permanent": true
    },
    {
      "source": "/fr/privacy-policy",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/golf-courses/alcanada",
      "destination": "/guides/alcanada-review",
      "permanent": true
    },
    {
      "source": "/golf-courses/alcanada-review",
      "destination": "/guides/alcanada-review",
      "permanent": true
    },
    {
      "source": "/golf-courses-391",
      "destination": "/golf-courses",
      "permanent": true
    },
    {
      "source": "/golf-courses/son-gual",
      "destination": "/guides/son-gual-review",
      "permanent": true
    },
    {
      "source": "/guides/a-day-at-son-gual",
      "destination": "/guides/play-with-a-pro-explained",
      "permanent": true
    },
    {
      "source": "/:locale(de|es|fr|nl|sv|zh)/guides/a-day-at-son-gual",
      "destination": "/:locale/play-with-a-pro",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "mrmallorcagolf.com" }],
      "destination": "https://www.mrmallorcagolf.com/$1",
      "permanent": true
    }
  ]
}
